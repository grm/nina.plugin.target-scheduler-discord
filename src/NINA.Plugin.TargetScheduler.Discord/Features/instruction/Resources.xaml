<ResourceDictionary x:Class="NINA.Plugin.TargetScheduler.Discord.Features.instruction.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:NINA.Plugin.TargetScheduler.Discord.Features.instruction"
    xmlns:nina="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer">
    <DataTemplate DataType="{x:Type local:SendTargetStatusInstruction}">
        <nina:SequenceBlockView>
            <nina:SequenceBlockView.SequenceItemContent>
                <TextBlock VerticalAlignment="Center"
                           Text="Posts Target Scheduler progress to the configured Discord webhook" />
            </nina:SequenceBlockView.SequenceItemContent>
        </nina:SequenceBlockView>
    </DataTemplate>
    <DataTemplate x:Key="NINA.Plugin.TargetScheduler.Discord.Features.instruction.SendTargetStatusInstruction_Mini">
        <TextBlock Text="{Binding Name}" />
    </DataTemplate>
</ResourceDictionary>
